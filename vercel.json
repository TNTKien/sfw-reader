{
  "buildCommand": "bun run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/scd-chapters/:id",
      "destination": "https://redive.suicaodex.com/v1/chapters/:id"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "installCommand": "bun install --frozen-lockfile"
}
